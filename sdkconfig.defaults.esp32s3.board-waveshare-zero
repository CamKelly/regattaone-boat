# Waveshare ESP32-S3-Zero — GPS + LoRa only (edge castellated GP4–GP13).
# Wiring: WIRING-ESP32S3-LORA-GPS.md § Waveshare Zero
#
# Module: ESP32-S3FH4R2 — 4 MB flash, 2 MB PSRAM.
# CONFIG_ESPTOOLPY_FLASHSIZE_8MB is not set
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
#
# Unavailable on this build (do not wire): GP14–GP18, GP38–GP42, GP45.
# IMU (GP10/11 I2C) and UWB (GP17/18) disabled until those pads are usable.
# GPS PPS off (GP16 unavailable) — NMEA works; TDMA needs PPS or menuconfig change.

CONFIG_REGATTAONE_S3_BOARD_WAVESHARE_ZERO=y
# CONFIG_REGATTAONE_S3_BOARD_DEVKIT_MINI is not set

CONFIG_REGATTAONE_SEN0140_ENABLE=n
CONFIG_REGATTAONE_RYUW122_ENABLE=n

# SX1262 LoRa (SPI2 / FSPI) — GP6–GP10, GP12–GP13 (MISO on GP10, not GP14)
CONFIG_SX1262_SPI_HOST_NUM=2
CONFIG_SX1262_SPI_MOSI_GPIO=13
CONFIG_SX1262_SPI_MISO_GPIO=10
CONFIG_SX1262_SPI_SCLK_GPIO=12
CONFIG_SX1262_SPI_CS_GPIO=9
CONFIG_SX1262_RESET_GPIO=8
CONFIG_SX1262_DIO1_GPIO=7
CONFIG_SX1262_BUSY_GPIO=6

# GPS NMEA 0183 (UART2) — GP4 / GP5
CONFIG_GPS_UART_PORT_NUM=2
CONFIG_GPS_UART_BAUD=9600
CONFIG_GPS_UART_TX_GPIO=4
CONFIG_GPS_UART_RX_GPIO=5
CONFIG_GPS_PPS_GPIO=-1
CONFIG_REGATTAONE_GPS_HW_CAPTURE=n
CONFIG_REGATTAONE_TDMA_ENABLE=n
# CONFIG_TDMA_GPTIMER_SCHEDULER is not set
