# ESP32-S3 — shared defaults (all board variants).
# LoRa stats JSON + GATT discovery need headroom on the NimBLE host task.
CONFIG_BT_NIMBLE_HOST_TASK_STACK_SIZE=8192
# Pick a board pin map via scripts/idf-s3.sh or sdkconfig.defaults.esp32s3.board-*.
#
# Flash size is set per board in sdkconfig.defaults.esp32s3.board-*:
#   devkit-mini / waveshare-zero → 4 MB
#   freenove-wroom-lite          → 8 MB
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# Feature flags (pins are in board-specific fragments)
CONFIG_REGATTAONE_SX1262_ENABLE=y
# Core1262 / many Waveshare SX1262 boards: TCXO on DIO3 (1.6 V). Use 0 for crystal-only modules.
CONFIG_SX1262_TCXO_VOLTAGE_MV=1600
CONFIG_SX1262_TX_QUEUE_DEPTH=8
CONFIG_SX1262_TX_DEFAULT_TTL_MS=30000
CONFIG_SX1262_RX_POLL_MS=100
CONFIG_REGATTAONE_GPS_ENABLE=y
CONFIG_REGATTAONE_RYUW122_ENABLE=y
CONFIG_RYUW122_UART_BAUD=115200
CONFIG_RYUW122_BOOT_DELAY_MS=1000

# TDMA — UTC slots from GPS PPS + RMC (requires PPS wired)
CONFIG_REGATTAONE_TDMA_ENABLE=y
CONFIG_TDMA_SLOT_US=100000
CONFIG_TDMA_NUM_SLOTS=10
CONFIG_TDMA_DEVICE_SLOT=-1
CONFIG_TDMA_GUARD_US=2000
CONFIG_REGATTAONE_GPS_HW_CAPTURE=y
CONFIG_TDMA_GPTIMER_SCHEDULER=y
# LoRa: CSMA/CAD only. TDMA schedule remains for UWB (TDMA_ENFORCE_UWB).
CONFIG_TDMA_ENFORCE_LORA_TX=n