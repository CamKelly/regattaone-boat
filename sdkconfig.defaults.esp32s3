# ESP32-S3 Mini — 8 MB flash (typical WEMOS/LOLIN modules).
# BLE: NimBLE only (no CONFIG_BTDM_* — those apply to original ESP32 dual-mode only).
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y

# --- ESP32-S3 Mini pin map (WEMOS/LOLIN-style IO4–IO21 headers) ---
# Full wiring: WIRING-ESP32S3-LORA-GPS.md

# SEN0140 IMU (I2C)
CONFIG_SEN0140_I2C_SDA_GPIO=10
CONFIG_SEN0140_I2C_SCL_GPIO=11

# SX1262 LoRa (SPI2 / FSPI) — RadioLib
CONFIG_REGATTAONE_SX1262_ENABLE=y
CONFIG_SX1262_SPI_HOST_NUM=2
CONFIG_SX1262_SPI_MOSI_GPIO=13
CONFIG_SX1262_SPI_MISO_GPIO=14
CONFIG_SX1262_SPI_SCLK_GPIO=12
CONFIG_SX1262_SPI_CS_GPIO=9
CONFIG_SX1262_RESET_GPIO=8
CONFIG_SX1262_DIO1_GPIO=7
CONFIG_SX1262_BUSY_GPIO=6

# GPS NMEA 0183 (UART2) + PPS
CONFIG_REGATTAONE_GPS_ENABLE=y
CONFIG_GPS_UART_PORT_NUM=2
CONFIG_GPS_UART_BAUD=9600
CONFIG_GPS_UART_TX_GPIO=4
CONFIG_GPS_UART_RX_GPIO=5
CONFIG_GPS_PPS_GPIO=21

# REYAX RYUW122 UWB (UART1)
CONFIG_REGATTAONE_RYUW122_ENABLE=y
CONFIG_RYUW122_UART_PORT_NUM=1
CONFIG_RYUW122_UART_TX_GPIO=17
CONFIG_RYUW122_UART_RX_GPIO=18

# Legacy Blues Notecard (I2C LoRaWAN) — replaced by SX1262 on this board
CONFIG_REGATTAONE_NOTECARD_ENABLE=n

# MSP430 off — GPIO17/18 used by RYUW122; disable for this bring-up
CONFIG_REGATTAONE_MSP430_ENABLE=n
