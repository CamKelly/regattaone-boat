# Freenove ESP32-S3 WROOM Lite — GPS UART + Meshtastic UART (no direct SX1262).
# Wiring: WIRING-ESP32S3-LORA-GPS.md § Freenove WROOM Lite
# Pinout: FREENOVE-ESP32S3-WROOM-LITE-PINOUT.md
# UWB: DWM3000 SPI — boards/WIRING-DWM3000.md
#
# ESP32-S3-WROOM-1 on this board: 8 MB flash (overrides shared 4 MB default).
# CONFIG_ESPTOOLPY_FLASHSIZE_4MB is not set
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y

CONFIG_REGATTAONE_S3_BOARD_FREENOVE_WROOM_LITE=y
# CONFIG_REGATTAONE_S3_BOARD_DEVKIT_MINI is not set
# CONFIG_REGATTAONE_S3_BOARD_WAVESHARE_ZERO is not set

# Console stays on USB/UART0 (GPIO 43/44) — do not move to USB-JTAG-only or idf monitor goes blank.

CONFIG_REGATTAONE_SEN0140_ENABLE=y

# SEN0140 IMU (I2C)
CONFIG_SEN0140_I2C_SDA_GPIO=10
CONFIG_SEN0140_I2C_SCL_GPIO=11

# Direct SX1262 LoRa disabled — radio is on companion Meshtastic ESP32.
# CONFIG_REGATTAONE_SX1262_ENABLE is not set

# GPS NMEA (UART1) — ESP GPIO4 TX → GPS RX, GPIO5 RX ← GPS TX
CONFIG_REGATTAONE_GPS_ENABLE=y
CONFIG_GPS_UART_PORT_NUM=1
CONFIG_GPS_UART_BAUD=9600
CONFIG_GPS_UART_TX_GPIO=4
CONFIG_GPS_UART_RX_GPIO=5
CONFIG_GPS_PPS_GPIO=21

# Meshtastic companion ESP32 (GPIO 15/16; UART2 — same as prior working builds)
CONFIG_REGATTAONE_MESHTASTIC_ENABLE=y
CONFIG_MESHTASTIC_UART_PORT_NUM=2
CONFIG_MESHTASTIC_UART_TX_GPIO=16
CONFIG_MESHTASTIC_UART_RX_GPIO=15
CONFIG_MESHTASTIC_UART_BAUD=921600
CONFIG_MESHTASTIC_BOOT_DELAY_MS=500

# DWM3000 SPI UWB — see boards/WIRING-DWM3000.md
CONFIG_REGATTAONE_DW3000_ENABLE=y
CONFIG_DW3000_RANGING_ENABLE=y
CONFIG_DW3000_ADDR=0x0001
CONFIG_DW3000_PANID=0xDECA
CONFIG_DW3000_ANTENNA_DELAY=16368
CONFIG_DW3000_TWR_PROCESSING_DELAY_US=8000
CONFIG_DW3000_SPI_MOSI=13
CONFIG_DW3000_SPI_MISO=14
CONFIG_DW3000_SPI_CLK=9
CONFIG_DW3000_SPI_CS=8
CONFIG_DW3000_GPIO_RESET=6
CONFIG_DW3000_GPIO_WAKEUP=17
CONFIG_DW3000_GPIO_IRQ=18
CONFIG_DW3000_SPI_MAX_MHZ=22
CONFIG_DW3000_CHIP_DW3000=y

# Port/Starboard mark broadcasts over Meshtastic — off; UWB start-line ranging instead
# CONFIG_REGATTAONE_MARK_BROADCAST_ENABLE is not set
CONFIG_BOAT_RANGE_INTERVAL_MS=10000
CONFIG_MARK_BLINK_INTERVAL_MS=1000
CONFIG_MARK_BLINK_FIXED_DELAY_US=5000
CONFIG_MARK_BLINK_ANCHOR_TWR_INTERVAL_MS=10000
CONFIG_MARK_BLINK_ANCHOR_TWR_DEFAULT=y
