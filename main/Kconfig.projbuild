if IDF_TARGET_ESP32S3

menu "RegattaOne — ESP32-S3 board"

    choice REGATTAONE_ESP32S3_BOARD
        prompt "Board pin map"
        default REGATTAONE_S3_BOARD_DEVKIT_MINI
        help
            Default GPIO map for your ESP32-S3 module. Individual pins remain
            editable in the RegattaOne menus below. After switching boards, use
            scripts/idf-s3.sh (recommended) or delete sdkconfig and reconfigure.

        config REGATTAONE_S3_BOARD_DEVKIT_MINI
            bool "ESP32-S3-DevKitM-1 / WEMOS LOLIN Mini (ESP32-S3-MINI-1 module)"
        config REGATTAONE_S3_BOARD_FREENOVE_WROOM_LITE
            bool "Freenove ESP32-S3 WROOM Lite"
        config REGATTAONE_S3_BOARD_WAVESHARE_ZERO
            bool "Waveshare ESP32-S3-Zero (ESP32-S3FH4R2)"
    endchoice

    comment "Freenove / DevKit: GPS+LoRa+IMU+UWB on GP4–18, GP21 PPS (see FREENOVE-ESP32S3-WROOM-LITE-PINOUT.md)"
        depends on REGATTAONE_S3_BOARD_FREENOVE_WROOM_LITE

    comment "Zero default map: GPS+LoRa on GP4–GP13 only; GP14–18/38–42/45 unavailable"
        depends on REGATTAONE_S3_BOARD_WAVESHARE_ZERO

endmenu

endif

menu "RegattaOne — SX1262 LoRa (SPI, RadioLib)"

    config REGATTAONE_SX1262_ENABLE
        bool "Enable SX1262 LoRa radio over SPI (RadioLib)"
        default y if IDF_TARGET_ESP32S3
        default n
        help
            When enabled, firmware initializes the SX1262 on the SPI bus defined below.
            Intended for direct LoRa (not LoRaWAN) using RadioLib on ESP-IDF.

    config SX1262_SPI_HOST_NUM
        int "SPI host (2 = SPI2_HOST / FSPI, 3 = SPI3_HOST / HSPI)"
        depends on REGATTAONE_SX1262_ENABLE
        range 2 3
        default 2
        help
            ESP-IDF SPI host index. SPI2 (FSPI) is typical for a dedicated LoRa module.

    config SX1262_SPI_MOSI_GPIO
        int "SPI MOSI (SDI) GPIO"
        depends on REGATTAONE_SX1262_ENABLE
        range 0 48 if IDF_TARGET_ESP32S3
        range 0 21 if IDF_TARGET_ESP32C3
        range 0 48
        default 13 if REGATTAONE_S3_BOARD_DEVKIT_MINI || REGATTAONE_S3_BOARD_FREENOVE_WROOM_LITE || REGATTAONE_S3_BOARD_WAVESHARE_ZERO
        default 13 if IDF_TARGET_ESP32S3
        default 6 if IDF_TARGET_ESP32C3

    config SX1262_SPI_MISO_GPIO
        int "SPI MISO (SDO) GPIO"
        depends on REGATTAONE_SX1262_ENABLE
        range 0 48 if IDF_TARGET_ESP32S3
        range 0 21 if IDF_TARGET_ESP32C3
        range 0 48
        default 10 if REGATTAONE_S3_BOARD_WAVESHARE_ZERO
        default 14 if REGATTAONE_S3_BOARD_DEVKIT_MINI || REGATTAONE_S3_BOARD_FREENOVE_WROOM_LITE
        default 14 if IDF_TARGET_ESP32S3
        default 5 if IDF_TARGET_ESP32C3

    config SX1262_SPI_SCLK_GPIO
        int "SPI SCLK (SCK) GPIO"
        depends on REGATTAONE_SX1262_ENABLE
        range 0 48 if IDF_TARGET_ESP32S3
        range 0 21 if IDF_TARGET_ESP32C3
        range 0 48
        default 12 if IDF_TARGET_ESP32S3
        default 4 if IDF_TARGET_ESP32C3

    config SX1262_SPI_CS_GPIO
        int "SPI CS / NSS GPIO"
        depends on REGATTAONE_SX1262_ENABLE
        range 0 48 if IDF_TARGET_ESP32S3
        range 0 21 if IDF_TARGET_ESP32C3
        range 0 48
        default 9 if IDF_TARGET_ESP32S3
        default 7 if IDF_TARGET_ESP32C3

    config SX1262_RESET_GPIO
        int "SX1262 RESET GPIO (-1 to omit)"
        depends on REGATTAONE_SX1262_ENABLE
        range -1 48
        default 8 if IDF_TARGET_ESP32S3
        default 3 if IDF_TARGET_ESP32C3

    config SX1262_DIO1_GPIO
        int "SX1262 DIO1 (IRQ) GPIO"
        depends on REGATTAONE_SX1262_ENABLE
        range 0 48 if IDF_TARGET_ESP32S3
        range 0 21 if IDF_TARGET_ESP32C3
        range 0 48
        default 7 if IDF_TARGET_ESP32S3
        default 2 if IDF_TARGET_ESP32C3

    config SX1262_BUSY_GPIO
        int "SX1262 BUSY GPIO (-1 to omit)"
        depends on REGATTAONE_SX1262_ENABLE
        range -1 48
        default 6 if IDF_TARGET_ESP32S3
        default 1 if IDF_TARGET_ESP32C3

    config SX1262_SPI_FREQ_HZ
        int "SPI clock (Hz)"
        depends on REGATTAONE_SX1262_ENABLE
        default 2000000
        range 100000 10000000
        help
            SX1262 SPI is typically 1–10 MHz. RadioLib examples often use 2 MHz.

    config SX1262_FREQ_HZ
        int "LoRa center frequency (Hz)"
        depends on REGATTAONE_SX1262_ENABLE
        default 915000000
        help
            Default 915000000 (US ISM). RegattaOne fleet firmware expects 915 MHz unless you
            intentionally change this for a non-US build.

    config SX1262_TX_POWER_DBM
        int "TX power (dBm)"
        depends on REGATTAONE_SX1262_ENABLE
        default 14
        range 2 22

    config SX1262_TX_QUEUE_DEPTH
        int "LoRa TX queue depth (CAD / CSMA backoff)"
        depends on REGATTAONE_SX1262_ENABLE
        default 8
        range 1 32

    config SX1262_TX_DEFAULT_TTL_MS
        int "Default TX queue TTL (ms) when BLE write omits TTL="
        depends on REGATTAONE_SX1262_ENABLE
        default 30000
        range 100 600000

    config SX1262_RX_POLL_MS
        int "LoRa RX poll period (ms); frees radio for CAD TX"
        depends on REGATTAONE_SX1262_ENABLE
        default 100
        range 20 500

    config SX1262_TCXO_VOLTAGE_MV
        int "TCXO reference on DIO3 (mV); 0 = crystal (XTAL) module"
        depends on REGATTAONE_SX1262_ENABLE
        default 0
        range 0 3300
        help
            RadioLib begin() tcxoVoltage argument. Most SX1262 breakouts (Ebyte E22,
            Waveshare, etc.) use a crystal — set 0. TCXO modules (some Heltec boards)
            need 1600 (1.6 V) or the value from the module datasheet. Wrong setting
            often causes SPI command errors (-706/-707) after init.

    config SX1262_RECOVER_AFTER_ERRORS
        int "Re-begin modem after this many consecutive radio errors (0 = off)"
        depends on REGATTAONE_SX1262_ENABLE
        default 3
        range 0 32
        help
            When startReceive / CAD / TX fails repeatedly, call begin() again to
            recover from a stuck SX1262 state.

endmenu

menu "RegattaOne — REYAX RYUW122 (UWB UART)"

    config REGATTAONE_RYUW122_ENABLE
        bool "Enable RYUW122 UART listener → BLE 0xFEF9"
        default y
        help
            UART lines (terminated by LF) are forwarded to Web Bluetooth as notifies on 0xFEF9.

    config RYUW122_UART_PORT_NUM
        int "UART controller (1 = UART_NUM_1 on XIAO; do not use 0 — D6/D7 are USB)"
        range 0 1
        default 1 if IDF_TARGET_ESP32C3
        default 1
        depends on REGATTAONE_RYUW122_ENABLE && !REGATTAONE_SC16IS752_ENABLE
        help
            XIAO ESP32-C3: use UART1 on D2/D3. UART0 (D6/D7) shares the USB-serial chip.
            Not used when UWB goes through SC16IS752 I2C bridge.

    config RYUW122_UART_BAUD
        int "UART baud (REYAX RYUW122 fixed at 115200)"
        default 115200

    config RYUW122_BOOT_DELAY_MS
        int "Delay after NRST release before read task (module boot)"
        range 0 5000
        default 1000
        help
            RYUW122 may need hundreds of ms after hardware reset before UART responds.

    choice DEVICE_DEFAULT_TYPE
        prompt "Default device type (NVS overrides after BLE save)"
        default DEVICE_DEFAULT_TYPE_BOAT

        config DEVICE_DEFAULT_TYPE_PORT
            bool "Port"
        config DEVICE_DEFAULT_TYPE_STARBOARD
            bool "Starboard"
        config DEVICE_DEFAULT_TYPE_FIXED_DGPS_MARK
            bool "Fixed DGPS mark"
        config DEVICE_DEFAULT_TYPE_WAYPOINT
            bool "Waypoint"
        config DEVICE_DEFAULT_TYPE_BOAT
            bool "Boat"
    endchoice

    config RYUW122_UART_TX_GPIO
        int "UWB module RX ← ESP TX (GPIO)"
        range 0 21 if IDF_TARGET_ESP32C3
        range 0 48 if IDF_TARGET_ESP32S3
        range 0 48
        default 5 if IDF_TARGET_ESP32C3
        default 17
        depends on REGATTAONE_RYUW122_ENABLE && !REGATTAONE_SC16IS752_ENABLE
        help
            XIAO ESP32-C3: pad D3 = GPIO5 (ESP TX → module RX). Not D6 (GPIO21 = USB).
            ESP32-S3 Mini: GPIO17 (header IO17) on UART1. Cross-connect: ESP TX → module RX.

    config RYUW122_UART_RX_GPIO
        int "UWB module TX → ESP RX (GPIO)"
        range 0 21 if IDF_TARGET_ESP32C3
        range 0 48 if IDF_TARGET_ESP32S3
        range 0 48
        default 4 if IDF_TARGET_ESP32C3
        default 18
        depends on REGATTAONE_RYUW122_ENABLE && !REGATTAONE_SC16IS752_ENABLE
        help
            XIAO ESP32-C3: pad D2 = GPIO4 (ESP RX ← module TX). Not D7 (GPIO20 = USB).
            ESP32-S3 Mini: GPIO18 (header IO18) on UART1. Cross-connect: ESP RX ← module TX.

    config RYUW122_NRST_GPIO
        int "REYAX NRST GPIO (-1 = not wired)"
        range -1 48 if IDF_TARGET_ESP32S3
        range -1 21 if IDF_TARGET_ESP32C3
        range -1 48
        default 12 if REGATTAONE_S3_BOARD_FREENOVE_WROOM_LITE
        default -1
        help
            Active-low hardware reset (REYAX pin 2). ESP drives high (run); brief
            low pulse resets the module after UART pins are configured.
            Freenove WROOM Lite: GPIO12 (PCB label 12) → REYAX NRST.

    config RYUW122_NRST_PULSE_MS
        int "NRST low pulse width (ms)"
        range 10 2000
        default 100
        help
            How long to hold NRST low during boot reset. 50–200 ms is typical.

endmenu

menu "RegattaOne — SC16IS752 (I2C dual-UART bridge)"

    config REGATTAONE_SC16IS752_ENABLE
        bool "Enable SC16IS752 I2C → dual UART (CJMCU-752)"
        default n
        help
            NXP SC16IS752 on I2C provides two UART channels (TXA/RXA, TXB/RXB).
            Use for RYUW122 UWB when native ESP32 UARTs are used for GPS/Meshtastic.
            See boards/WIRING-SC16IS752-I2C.md.

    config SC16IS752_USE_SEN0140_I2C_PINS
        bool "Share I2C bus with SEN0140 (same SDA/SCL GPIOs)"
        default y if REGATTAONE_SEN0140_ENABLE
        default n
        depends on REGATTAONE_SC16IS752_ENABLE
        help
            Freenove Option A: wire SC16IS752 SDA/SCL to IMU GPIO10/GPIO11.
            When SEN0140 is enabled, reuse its I2C master bus handle.

    config SC16IS752_I2C_SDA_GPIO
        int "SDA GPIO (standalone bus only)"
        range 0 48
        default 10
        depends on REGATTAONE_SC16IS752_ENABLE && !SC16IS752_USE_SEN0140_I2C_PINS

    config SC16IS752_I2C_SCL_GPIO
        int "SCL GPIO (standalone bus only)"
        range 0 48
        default 11
        depends on REGATTAONE_SC16IS752_ENABLE && !SC16IS752_USE_SEN0140_I2C_PINS

    config SC16IS752_I2C_ADDR
        hex "7-bit I2C address (CJMCU: A0G A1G → 0x4D)"
        default 0x4D
        depends on REGATTAONE_SC16IS752_ENABLE
        help
            CJMCU-752 with A0/A1 tied only to VDD or GND:
            0x48 (both 3V3), 0x49 (A0 GND A1 3V3), 0x4C (A0 3V3 A1 GND),
            0x4D (both GND — common when both straps go to GND).
            NOT the sequential 0x48–0x4B table from some datasheet summaries.

    config SC16IS752_CRYSTAL_HZ
        int "External crystal frequency (Hz)"
        default 1843200
        depends on REGATTAONE_SC16IS752_ENABLE
        help
            CJMCU-752 boards vary: this project board uses 1.8432 MHz (1843200).
            Wrong value causes garbage UART even when I2C works.

    config SC16IS752_IRQ_GPIO
        int "IRQ GPIO (-1 = poll only)"
        range -1 48
        default 7 if REGATTAONE_S3_BOARD_FREENOVE_WROOM_LITE
        default -1
        depends on REGATTAONE_SC16IS752_ENABLE

    config SC16IS752_RESET_GPIO
        int "RESET GPIO (-1 = tied to 3V3)"
        range -1 48
        default 12 if REGATTAONE_S3_BOARD_FREENOVE_WROOM_LITE
        default -1
        depends on REGATTAONE_SC16IS752_ENABLE

    config SC16IS752_RESET_PULSE_MS
        int "RESET low pulse width (ms)"
        range 1 500
        default 10
        depends on REGATTAONE_SC16IS752_ENABLE && SC16IS752_RESET_GPIO >= 0

    config SC16IS752_CH_A_BAUD
        int "Channel A baud (TXA/RXA — RYUW122 anchor)"
        default 115200
        depends on REGATTAONE_SC16IS752_ENABLE

    config SC16IS752_CH_B_ENABLE
        bool "Enable channel B (TXB/RXB)"
        default n
        depends on REGATTAONE_SC16IS752_ENABLE

    config SC16IS752_CH_B_BAUD
        int "Channel B baud"
        default 115200
        depends on REGATTAONE_SC16IS752_ENABLE && SC16IS752_CH_B_ENABLE

    config SC16IS752_UWB_CHANNEL
        int "RYUW122 / BLE UWB uses UART channel (0=A, 1=B)"
        range 0 1
        default 0
        depends on REGATTAONE_SC16IS752_ENABLE

    config SC16IS752_CH_B_LISTEN
        bool "Also forward the other channel to BLE 0xFEF9"
        default n
        depends on REGATTAONE_SC16IS752_ENABLE && SC16IS752_CH_B_ENABLE

endmenu

menu "RegattaOne — GPS (NMEA 0183 UART + PPS)"

    config REGATTAONE_GPS_ENABLE
        bool "Enable GPS NMEA UART listener → BLE 0xFEFD"
        default n
        help
            Read NMEA 0183 from a GPS module UART and notify lines on BLE 0xFEFD.
            Freenove / DevKit: GPIO4 TX → GPS RX, GPIO5 RX ← GPS TX, UART2.
            On Freenove with Meshtastic, use UART2 for GPS and UART0 for Meshtastic
            (console on USB Serial/JTAG).

    config GPS_UART_PORT_NUM
        int "UART controller"
        range 0 2
        default 1 if REGATTAONE_S3_BOARD_FREENOVE_WROOM_LITE
        default 2
        depends on REGATTAONE_GPS_ENABLE
        help
            Freenove with Meshtastic on UART2: use UART1 for GPS (GPIO 4/5).
            DevKit / Zero without Meshtastic UART2 conflict: UART2 is fine.

    config GPS_UART_BAUD
        int "UART baud (match GPS module)"
        default 9600
        depends on REGATTAONE_GPS_ENABLE
        help
            Most modules default to 9600. Some ship at 115200 — match your module.

    config GPS_UART_TX_GPIO
        int "GPS module RX ← ESP TX (GPIO)"
        range 0 48
        default 4
        depends on REGATTAONE_GPS_ENABLE

    config GPS_UART_RX_GPIO
        int "GPS module TX → ESP RX (GPIO)"
        range 0 48
        default 5
        depends on REGATTAONE_GPS_ENABLE

    config GPS_PPS_GPIO
        int "GPS PPS input GPIO (-1 = unwired)"
        range -1 48
        default 21
        depends on REGATTAONE_GPS_ENABLE
        help
            Optional 1 Hz pulse-per-second input (rising edge). When wired, firmware
            emits $PREGPPS lines on BLE 0xFEFD alongside NMEA. Set -1 if unwired.

    config GPS_BOOT_DELAY_MS
        int "Delay after UART init before first read (ms)"
        range 0 10000
        default 200
        depends on REGATTAONE_GPS_ENABLE

endmenu

menu "RegattaOne — Meshtastic UART (LoRa via companion ESP32)"

    config REGATTAONE_MESHTASTIC_ENABLE
        bool "Enable Meshtastic Client API (UART PROTO → BLE)"
        default n
        help
            UART to a companion ESP32 running Meshtastic firmware (SX1262 on that board).
            Set the Meshtastic serial module to PROTO mode and match baud here.
            Firmware speaks the Meshtastic Client API (ToRadio/FromRadio protobuf).
            Line log notify 0xFEE5; command write 0xFEE6; roster JSON 0xFEE7.

    config MESHTASTIC_UART_PORT_NUM
        int "UART controller (2 on Freenove; 0 only if console is USB-JTAG)"
        range 0 2
        default 2 if REGATTAONE_S3_BOARD_FREENOVE_WROOM_LITE
        default 0
        depends on REGATTAONE_MESHTASTIC_ENABLE

    config MESHTASTIC_UART_BAUD
        int "UART baud (must match Meshtastic serial module)"
        default 921600
        depends on REGATTAONE_MESHTASTIC_ENABLE
        help
            Common values: 921600, 115200. Meshtastic serial module baud must match.

    config MESHTASTIC_BOOT_DELAY_MS
        int "Delay after UART init before first read (companion boot)"
        range 0 10000
        default 500
        depends on REGATTAONE_MESHTASTIC_ENABLE

    config MESHTASTIC_UART_TX_GPIO
        int "Meshtastic module RX ← ESP TX (GPIO)"
        range 0 48
        default 16
        depends on REGATTAONE_MESHTASTIC_ENABLE
        help
            Freenove WROOM Lite: left header GPIO16 (PCB label 16).

    config MESHTASTIC_UART_RX_GPIO
        int "Meshtastic module TX → ESP RX (GPIO)"
        range 0 48
        default 15
        depends on REGATTAONE_MESHTASTIC_ENABLE
        help
            Freenove WROOM Lite: left header GPIO15 (PCB label 15).

endmenu

config REGATTAONE_SEN0140_ENABLE
    bool "Enable SEN0140 10-DOF IMU (I2C probe + BLE 0xFEF1 task)"
    default y
    help
        When disabled, the firmware does not create the SEN0140 I2C stack or IMU task.
        Turn this off for GPS + LoRa + UWB bring-up without a DFRobot SEN0140 board.

menu "RegattaOne — SEN0140 I2C pins"

    config SEN0140_I2C_SDA_GPIO
        int "GPIO for SEN0140 I2C SDA"
        range 0 21 if IDF_TARGET_ESP32C3
        range 0 48 if IDF_TARGET_ESP32S3
        range 0 39 if IDF_TARGET_ESP32
        range 0 48
        default 6 if IDF_TARGET_ESP32C3
        default 10
        help
            ESP32-C3: only GPIO 0–21 exist on the chip.
            Seeed XIAO ESP32-C3: SoC GPIO6 is the pad labeled D4 (often SDA on silk), NOT pad D6 (D6 is UART TX / GPIO21).
            ESP32-S3 DevKit Mini / Freenove WROOM Lite: GPIO10 (SDA), GPIO11 (SCL).
            Waveshare ESP32-S3-Zero: GP10 / GP11 on the right edge.
            Set to match your wiring, then idf.py build.

    config SEN0140_I2C_SCL_GPIO
        int "GPIO for SEN0140 I2C SCL"
        range 0 21 if IDF_TARGET_ESP32C3
        range 0 48 if IDF_TARGET_ESP32S3
        range 0 39 if IDF_TARGET_ESP32
        range 0 48
        default 7 if IDF_TARGET_ESP32C3
        default 11
        help
            ESP32-C3: only GPIO 0–21.
            Seeed XIAO ESP32-C3: SoC GPIO7 is the pad labeled D5 (often SCL), NOT pad D7 (D7 is UART RX / GPIO20).
            ESP32-S3 DevKit Mini / Freenove / Waveshare Zero: GPIO11 (SCL).

endmenu
