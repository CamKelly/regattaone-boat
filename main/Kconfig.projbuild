if IDF_TARGET_ESP32S3

menu "RegattaOne — ESP32-S3 board"

    choice REGATTAONE_ESP32S3_BOARD
        prompt "Board pin map"
        default REGATTAONE_S3_BOARD_DEVKIT_MINI
        help
            Default GPIO map for your ESP32-S3 module. Individual pins remain
            editable in the RegattaOne menus below. After switching boards, use
            scripts/idf-s3.sh (recommended) or delete sdkconfig and reconfigure.

        config REGATTAONE_S3_BOARD_DEVKIT_MINI
            bool "ESP32-S3-DevKitM-1 / WEMOS LOLIN Mini (ESP32-S3-MINI-1 module)"
        config REGATTAONE_S3_BOARD_WAVESHARE_ZERO
            bool "Waveshare ESP32-S3-Zero (ESP32-S3FH4R2)"
    endchoice

endmenu

endif

menu "RegattaOne — SX1262 LoRa (SPI, RadioLib)"

    config REGATTAONE_SX1262_ENABLE
        bool "Enable SX1262 LoRa radio over SPI (RadioLib)"
        default y if IDF_TARGET_ESP32S3
        default n
        help
            When enabled, firmware initializes the SX1262 on the SPI bus defined below.
            Intended for direct LoRa (not LoRaWAN) using RadioLib on ESP-IDF.

    config SX1262_SPI_HOST_NUM
        int "SPI host (2 = SPI2_HOST / FSPI, 3 = SPI3_HOST / HSPI)"
        depends on REGATTAONE_SX1262_ENABLE
        range 2 3
        default 2
        help
            ESP-IDF SPI host index. SPI2 (FSPI) is typical for a dedicated LoRa module.

    config SX1262_SPI_MOSI_GPIO
        int "SPI MOSI (SDI) GPIO"
        depends on REGATTAONE_SX1262_ENABLE
        range 0 48 if IDF_TARGET_ESP32S3
        range 0 21 if IDF_TARGET_ESP32C3
        range 0 48
        default 13 if REGATTAONE_S3_BOARD_DEVKIT_MINI || REGATTAONE_S3_BOARD_WAVESHARE_ZERO
        default 13 if IDF_TARGET_ESP32S3
        default 6 if IDF_TARGET_ESP32C3

    config SX1262_SPI_MISO_GPIO
        int "SPI MISO (SDO) GPIO"
        depends on REGATTAONE_SX1262_ENABLE
        range 0 48 if IDF_TARGET_ESP32S3
        range 0 21 if IDF_TARGET_ESP32C3
        range 0 48
        default 14 if IDF_TARGET_ESP32S3
        default 5 if IDF_TARGET_ESP32C3

    config SX1262_SPI_SCLK_GPIO
        int "SPI SCLK (SCK) GPIO"
        depends on REGATTAONE_SX1262_ENABLE
        range 0 48 if IDF_TARGET_ESP32S3
        range 0 21 if IDF_TARGET_ESP32C3
        range 0 48
        default 12 if IDF_TARGET_ESP32S3
        default 4 if IDF_TARGET_ESP32C3

    config SX1262_SPI_CS_GPIO
        int "SPI CS / NSS GPIO"
        depends on REGATTAONE_SX1262_ENABLE
        range 0 48 if IDF_TARGET_ESP32S3
        range 0 21 if IDF_TARGET_ESP32C3
        range 0 48
        default 9 if IDF_TARGET_ESP32S3
        default 7 if IDF_TARGET_ESP32C3

    config SX1262_RESET_GPIO
        int "SX1262 RESET GPIO (-1 to omit)"
        depends on REGATTAONE_SX1262_ENABLE
        range -1 48
        default 8 if IDF_TARGET_ESP32S3
        default 3 if IDF_TARGET_ESP32C3

    config SX1262_DIO1_GPIO
        int "SX1262 DIO1 (IRQ) GPIO"
        depends on REGATTAONE_SX1262_ENABLE
        range 0 48 if IDF_TARGET_ESP32S3
        range 0 21 if IDF_TARGET_ESP32C3
        range 0 48
        default 7 if IDF_TARGET_ESP32S3
        default 2 if IDF_TARGET_ESP32C3

    config SX1262_BUSY_GPIO
        int "SX1262 BUSY GPIO (-1 to omit)"
        depends on REGATTAONE_SX1262_ENABLE
        range -1 48
        default 6 if IDF_TARGET_ESP32S3
        default 1 if IDF_TARGET_ESP32C3

    config SX1262_SPI_FREQ_HZ
        int "SPI clock (Hz)"
        depends on REGATTAONE_SX1262_ENABLE
        default 2000000
        range 100000 10000000
        help
            SX1262 SPI is typically 1–10 MHz. RadioLib examples often use 2 MHz.

    config SX1262_FREQ_HZ
        int "LoRa center frequency (Hz)"
        depends on REGATTAONE_SX1262_ENABLE
        default 915000000
        help
            915 MHz (US) or 868 MHz (EU) depending on your module and regulations.

    config SX1262_TX_POWER_DBM
        int "TX power (dBm)"
        depends on REGATTAONE_SX1262_ENABLE
        default 14
        range 2 22

endmenu

menu "RegattaOne — GPS (NMEA 0183 UART + PPS)"

    config REGATTAONE_GPS_ENABLE
        bool "Enable GPS NMEA 0183 UART listener + PPS input"
        default y if IDF_TARGET_ESP32S3
        default n
        help
            Reads NMEA sentences on a dedicated UART. PPS is a separate GPIO for
            1 Hz pulse-per-second timing (optional but recommended for DGPS marks).

    config GPS_UART_PORT_NUM
        int "UART controller for GPS (2 = UART_NUM_2; RYUW122 uses UART1 on S3)"
        depends on REGATTAONE_GPS_ENABLE
        range 0 2
        default 2 if IDF_TARGET_ESP32S3
        default 1

    config GPS_UART_BAUD
        int "GPS UART baud (NMEA 0183; module default often 9600 or 115200)"
        depends on REGATTAONE_GPS_ENABLE
        default 9600

    config GPS_UART_TX_GPIO
        int "GPS module RX ← ESP TX (GPIO)"
        depends on REGATTAONE_GPS_ENABLE
        range 0 48 if IDF_TARGET_ESP32S3
        range 0 21 if IDF_TARGET_ESP32C3
        range 0 48
        default 4 if IDF_TARGET_ESP32S3
        default 8 if IDF_TARGET_ESP32C3
        help
            ESP32-S3 Mini: GPIO4 (header IO4). Cross-connect: ESP TX → GPS RX.

    config GPS_UART_RX_GPIO
        int "GPS module TX → ESP RX (GPIO)"
        depends on REGATTAONE_GPS_ENABLE
        range 0 48 if IDF_TARGET_ESP32S3
        range 0 21 if IDF_TARGET_ESP32C3
        range 0 48
        default 5 if IDF_TARGET_ESP32S3
        default 9 if IDF_TARGET_ESP32C3
        help
            ESP32-S3 Mini: GPIO5 (header IO5). Cross-connect: ESP RX ← GPS TX.

    config GPS_PPS_GPIO
        int "GPS PPS input GPIO (-1 to disable)"
        depends on REGATTAONE_GPS_ENABLE
        range -1 48
        default 21 if REGATTAONE_S3_BOARD_DEVKIT_MINI
        default 16 if REGATTAONE_S3_BOARD_WAVESHARE_ZERO
        default 10 if IDF_TARGET_ESP32C3
        help
            1 Hz pulse-per-second from the GPS module.
            DevKit Mini: GPIO21 (IO21). Waveshare Zero: GPIO16 — GPIO21 is the onboard WS2812.
            Leave at -1 if your module has no PPS output wired.

endmenu

menu "RegattaOne — TDMA (PPS-synchronized UTC slots)"

    config REGATTAONE_TDMA_ENABLE
        bool "Enable UTC-aligned TDMA time slots (requires GPS + PPS)"
        depends on REGATTAONE_GPS_ENABLE
        default y
        help
            Disciplines a UTC microsecond clock from GPS PPS (1 Hz) and RMC time.
            All nodes compute the same slot index from UTC; each device transmits
            only in its assigned slot (LoRa / UWB).

    config TDMA_SLOT_US
        int "Slot length (microseconds)"
        depends on REGATTAONE_TDMA_ENABLE
        default 100000
        range 1000 60000000
        help
            Duration of one TDMA slot. 100000 = 100 ms.

    config TDMA_NUM_SLOTS
        int "Slots per frame"
        depends on REGATTAONE_TDMA_ENABLE
        default 10
        range 2 256

    config TDMA_DEVICE_SLOT
        int "This device slot index (-1 = hash from boat id)"
        depends on REGATTAONE_TDMA_ENABLE
        default -1
        range -1 255

    config TDMA_GUARD_US
        int "Guard band at slot edges (microseconds)"
        depends on REGATTAONE_TDMA_ENABLE
        default 2000
        range 0 500000
        help
            No TX in the first/last guard_us of each slot (turnaround / clock skew).

    config TDMA_ENFORCE_LORA_TX
        bool "Reject LoRa transmit outside assigned slot"
        depends on REGATTAONE_TDMA_ENABLE && REGATTAONE_SX1262_ENABLE
        default y

    config TDMA_ENFORCE_UWB
        bool "Gate UWB activity on TDMA slot (ryuw122_tdma_can_use_now)"
        depends on REGATTAONE_TDMA_ENABLE && REGATTAONE_RYUW122_ENABLE
        default y

endmenu

menu "RegattaOne — Blues Notecard (legacy LoRaWAN, I2C)"

    config REGATTAONE_NOTECARD_ENABLE
        bool "Enable Blues Notecard over I2C (serial-over-I2C)"
        default n
        help
            When enabled, GATT writes to 0xFEF7 run JSON transactions on the Notecard (default address 0x17).
            Shares the SEN0140 I2C bus when that bus exists; otherwise creates a dedicated bus on NOTECARD pins.

    config NOTECARD_I2C_ADDR_7BIT
        hex "Notecard 7-bit I2C address"
        default 0x17
        help
            Blues default is 0x17 unless changed with a card.io request.

    config NOTECARD_I2C_FREQ_HZ
        int "Notecard I2C clock (Hz)"
        default 100000

    config NOTECARD_I2C_PORT_NUM
        int "I2C port (0 = I2C_NUM_0)"
        range 0 1
        default 0

    config NOTECARD_I2C_SDA_GPIO
        int "Standalone Notecard bus SDA GPIO (used only if SEN0140 bus is unavailable)"
        range 0 21 if IDF_TARGET_ESP32C3
        range 0 48 if IDF_TARGET_ESP32S3
        range 0 48
        default 6 if IDF_TARGET_ESP32C3
        default 10

    config NOTECARD_I2C_SCL_GPIO
        int "Standalone Notecard bus SCL GPIO (used only if SEN0140 bus is unavailable)"
        range 0 21 if IDF_TARGET_ESP32C3
        range 0 48 if IDF_TARGET_ESP32S3
        range 0 48
        default 7 if IDF_TARGET_ESP32C3
        default 11

    config REGATTAONE_PRESENCE_SYNC_ENABLE
        bool "Enable device presence sync (presence.qi / presence_ack.qo)"
        depends on REGATTAONE_NOTECARD_ENABLE
        default y
        help
            Poll Notehub inbound presence.qi, apply peer deltas locally, and ack on presence_ack.qo.

    config PRESENCE_AUTO_POLL
        bool "Automatic presence hub.sync polling (disable for manual BLE testing)"
        depends on REGATTAONE_PRESENCE_SYNC_ENABLE
        default y
        help
            When disabled, firmware does not start the background presence poll task.
            Use the BLE Notecard JSON box to run hub.sync, file.changes, and note.get manually.
            boat.qo boot notes still work.

    config PRESENCE_POLL_INTERVAL_SEC
        int "Presence hub.sync + poll interval (seconds)"
        depends on REGATTAONE_PRESENCE_SYNC_ENABLE
        default 300
        range 60 86400
        help
            Used when PRESENCE_AUTO_POLL is enabled (background task) and for
            hub.set periodic inbound interval when PRESENCE_HUB_CONTINUOUS is off.

    config PRESENCE_DRAIN_IDLE_ATTEMPTS
        int "Inbound drain retries after hub.sync (LoRa needs more)"
        depends on REGATTAONE_PRESENCE_SYNC_ENABLE
        default 20
        range 1 60
        help
            After hub.sync, retry note.get this many times (3 s apart) waiting for
            LoRaWAN downlink. 20 attempts ≈ 60 s of waiting per poll.
            Only used when PRESENCE_AUTO_POLL is enabled.

    config PRESENCE_SYNC_WAIT_SEC
        int "Max seconds to wait for hub.sync completion (LoRa)"
        depends on REGATTAONE_PRESENCE_SYNC_ENABLE
        default 300
        range 60 600
        help
            Poll hub.sync.status until sync-end. Do not issue another hub.sync
            while status is sync in progress — that can prevent LoRa downlink.

    config PRESENCE_HUB_CONTINUOUS
        bool "Use continuous hub mode (faster LoRa inbound, more power)"
        depends on REGATTAONE_PRESENCE_SYNC_ENABLE
        default y
        help
            continuous + sync:true keeps the Notecard checking Notehub more
            aggressively. Recommended for LoRaWAN (NOTE-LWUS) presence testing.

    config PRESENCE_ACK_PORT
        int "Notehub port for presence_ack.qo template"
        depends on REGATTAONE_PRESENCE_SYNC_ENABLE
        default 12
        range 1 99

    config PRESENCE_MAX_PEERS
        int "Max tracked peer devices"
        depends on REGATTAONE_PRESENCE_SYNC_ENABLE
        default 32
        range 4 128

    config NOTEHUB_PRODUCT_UID
        string "Notehub product UID for hub.set (empty = skip)"
        depends on REGATTAONE_PRESENCE_SYNC_ENABLE
        default "com.ellph.camkelly:regattaone"
        help
            Blues product UID for hub.set, e.g. com.company.project:product.
            Must match the Notecard's Notehub product (see Notehub device Events).
            Leave empty only if the Notecard is already provisioned via another tool.

endmenu

menu "RegattaOne — REYAX RYUW122 (UWB UART)"

    config REGATTAONE_RYUW122_ENABLE
        bool "Enable RYUW122 UART listener → BLE 0xFEF9"
        default y
        help
            UART lines (terminated by LF) are forwarded to Web Bluetooth as notifies on 0xFEF9.

    config RYUW122_UART_PORT_NUM
        int "UART controller (1 = UART_NUM_1 on XIAO; do not use 0 — D6/D7 are USB)"
        range 0 1
        default 1 if IDF_TARGET_ESP32C3
        default 1
        help
            XIAO ESP32-C3: use UART1 on D2/D3. UART0 (D6/D7) shares the USB-serial chip.

    config RYUW122_UART_BAUD
        int "UART baud after probe (REYAX default 115200; boot probes 115200/9600/57600)"
        default 115200

    config RYUW122_BOOT_DELAY_MS
        int "Delay after UART init before AT probe (module power-up)"
        range 0 5000
        default 1000
        help
            RYUW122 may need hundreds of ms after power before UART responds.

    choice DEVICE_DEFAULT_TYPE
        prompt "Default device type (NVS overrides after BLE save)"
        default DEVICE_DEFAULT_TYPE_BOAT

        config DEVICE_DEFAULT_TYPE_PORT
            bool "Port"
        config DEVICE_DEFAULT_TYPE_STARBOARD
            bool "Starboard"
        config DEVICE_DEFAULT_TYPE_FIXED_DGPS_MARK
            bool "Fixed DGPS mark"
        config DEVICE_DEFAULT_TYPE_WAYPOINT
            bool "Waypoint"
        config DEVICE_DEFAULT_TYPE_BOAT
            bool "Boat"
    endchoice

    config RYUW122_UART_TX_GPIO
        int "UWB module RX ← ESP TX (GPIO)"
        range 0 21 if IDF_TARGET_ESP32C3
        range 0 48 if IDF_TARGET_ESP32S3
        range 0 48
        default 5 if IDF_TARGET_ESP32C3
        default 17
        help
            XIAO ESP32-C3: pad D3 = GPIO5 (ESP TX → module RX). Not D6 (GPIO21 = USB).
            ESP32-S3 Mini: GPIO17 (header IO17) on UART1. Cross-connect: ESP TX → module RX.

    config RYUW122_UART_RX_GPIO
        int "UWB module TX → ESP RX (GPIO)"
        range 0 21 if IDF_TARGET_ESP32C3
        range 0 48 if IDF_TARGET_ESP32S3
        range 0 48
        default 4 if IDF_TARGET_ESP32C3
        default 18
        help
            XIAO ESP32-C3: pad D2 = GPIO4 (ESP RX ← module TX). Not D7 (GPIO20 = USB).
            ESP32-S3 Mini: GPIO18 (header IO18) on UART1. Cross-connect: ESP RX ← module TX.

endmenu

menu "RegattaOne — MSP430"

    config REGATTAONE_MSP430_ENABLE
        bool "Enable MSP430 BSL GPIO + UART bridge"
        default n
        help
            When disabled, the app does not touch RST/TEST GPIOs or the MSP430 UART peripheral.
            Use this for IMU-only bring-up (SEN0140 + BLE). Enable when the MSP430 is connected.

endmenu

config REGATTAONE_SEN0140_ENABLE
    bool "Enable SEN0140 10-DOF IMU (I2C probe + BLE 0xFEF1 task)"
    default y
    help
        When disabled, the firmware does not create the SEN0140 I2C stack or IMU task.
        Blues Notecard then uses the standalone I2C bus on NOTECARD_* GPIOs (same defaults as SEN0140 pins if you wire only the Notecard).
        Turn this off for Notecard + UWB bring-up without a DFRobot SEN0140 board.

menu "RegattaOne — SEN0140 I2C pins"

    config SEN0140_I2C_SDA_GPIO
        int "GPIO for SEN0140 I2C SDA"
        range 0 21 if IDF_TARGET_ESP32C3
        range 0 48 if IDF_TARGET_ESP32S3
        range 0 39 if IDF_TARGET_ESP32
        range 0 48
        default 6 if IDF_TARGET_ESP32C3
        default 10
        help
            ESP32-C3: only GPIO 0–21 exist on the chip.
            Seeed XIAO ESP32-C3: SoC GPIO6 is the pad labeled D4 (often SDA on silk), NOT pad D6 (D6 is UART TX / GPIO21).
            ESP32-S3 DevKit Mini: GPIO10 = header IO10 (SDA), GPIO11 = IO11 (SCL).
            Waveshare ESP32-S3-Zero: GP10 / GP11 on the right edge.
            Set to match your wiring, then idf.py build.

    config SEN0140_I2C_SCL_GPIO
        int "GPIO for SEN0140 I2C SCL"
        range 0 21 if IDF_TARGET_ESP32C3
        range 0 48 if IDF_TARGET_ESP32S3
        range 0 39 if IDF_TARGET_ESP32
        range 0 48
        default 7 if IDF_TARGET_ESP32C3
        default 11
        help
            ESP32-C3: only GPIO 0–21.
            Seeed XIAO ESP32-C3: SoC GPIO7 is the pad labeled D5 (often SCL), NOT pad D7 (D7 is UART RX / GPIO20).
            ESP32-S3 DevKit Mini / Waveshare Zero: GPIO11 = header GP11 (SCL).

endmenu
