# ESP32-C3: BLE-only controller (no CONFIG_BTDM_* — those are ESP32 / ESP32-S3).
# Common Seeed XIAO ESP32-C3 modules use 4 MB flash.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

CONFIG_BT_ENABLED=y
CONFIG_BT_CONTROLLER_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_GAP_SERVICE=y
CONFIG_BT_BLUEDROID_ENABLED=n
CONFIG_BT_NIMBLE_LOG_LEVEL_WARNING=y
CONFIG_BT_NIMBLE_HOST_TASK_STACK_SIZE=6144
CONFIG_FREERTOS_TIMER_TASK_STACK_DEPTH=4096
CONFIG_BT_NIMBLE_MSYS_1_BLOCK_COUNT=96
CONFIG_BT_NIMBLE_MSYS_2_BLOCK_COUNT=96

CONFIG_REGATTAONE_NOTECARD_ENABLE=n

# RYUW122 on XIAO D6 (TX / GPIO21) and D7 (RX / GPIO20). UART0 — console must not use those pins.
CONFIG_ESP_CONSOLE_UART_DEFAULT=n
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_RYUW122_UART_PORT_NUM=0
CONFIG_RYUW122_UART_TX_GPIO=21
CONFIG_RYUW122_UART_RX_GPIO=20
