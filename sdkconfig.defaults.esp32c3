# ESP32-C3: BLE-only controller (no CONFIG_BTDM_* — those are ESP32 / ESP32-S3).
# Common Seeed XIAO ESP32-C3 modules use 4 MB flash.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

CONFIG_BT_ENABLED=y
CONFIG_BT_CONTROLLER_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_GAP_SERVICE=y
CONFIG_BT_BLUEDROID_ENABLED=n
CONFIG_BT_NIMBLE_LOG_LEVEL_WARNING=y
CONFIG_BT_NIMBLE_HOST_TASK_STACK_SIZE=6144
CONFIG_FREERTOS_TIMER_TASK_STACK_DEPTH=4096
CONFIG_BT_NIMBLE_MSYS_1_BLOCK_COUNT=96
CONFIG_BT_NIMBLE_MSYS_2_BLOCK_COUNT=96

# SEN0140 on XIAO D4/D5 (GPIO6/7) — see WIRING-SEN0140.md
CONFIG_REGATTAONE_SEN0140_ENABLE=y
CONFIG_SEN0140_I2C_SDA_GPIO=6
CONFIG_SEN0140_I2C_SCL_GPIO=7

# Console over USB; RYUW122 on UART1 D2/D3 — NOT D6/D7 (USB-serial chip)
CONFIG_ESP_CONSOLE_UART_DEFAULT=n
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_REGATTAONE_RYUW122_ENABLE=y
CONFIG_RYUW122_UART_PORT_NUM=1
CONFIG_RYUW122_UART_BAUD=115200
CONFIG_RYUW122_BOOT_DELAY_MS=500
CONFIG_RYUW122_UART_TX_GPIO=5
CONFIG_RYUW122_UART_RX_GPIO=4
